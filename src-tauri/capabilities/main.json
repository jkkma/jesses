{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window: inspect files and run validated remux jobs to selected destinations.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-probe-media",
    "allow-get-capabilities",
    "allow-start-remux",
    "allow-cancel-job",
    "allow-list-jobs",
    "allow-subscribe-jobs"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window: choose files, inspect media, and manage single-file encoding jobs.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "allow-probe-media",
    "allow-get-capabilities",
    "allow-start-encode",
    "allow-list-jobs",
    "allow-cancel-encode"
  ]
}

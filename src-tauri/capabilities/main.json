{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window: inspect files and run validated media jobs to selected destinations.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-get-preferences",
    "allow-get-parameter-presets",
    "allow-save-parameter-preset",
    "allow-remove-parameter-preset",
    "allow-save-preferences",
    "allow-remember-recent-media",
    "allow-preview-preference-import",
    "allow-recent-path-is-folder",
    "allow-get-storage-locations",
    "allow-begin-media-analysis",
    "allow-cancel-media-analysis",
    "allow-preview-frame",
    "allow-detect-crop",
    "allow-get-encoder-parameters",
    "allow-preview-encode-plan",
    "allow-analyze-bitrate",
    "allow-analyze-quality",
    "allow-export-analysis",
    "allow-set-job-paused",
    "allow-measure-loudness",
    "allow-probe-media",
    "allow-get-capabilities",
    "allow-start-remux",
    "allow-start-mux",
    "allow-start-encode",
    "allow-enqueue-encode",
    "allow-scan-media-folder",
    "allow-preview-encode-batch",
    "allow-enqueue-encode-batch",
    "allow-cancel-all-jobs",
    "allow-cancel-job",
    "allow-stop-job",
    "allow-resume-job",
    "allow-list-jobs",
    "allow-subscribe-jobs"
  ]
}

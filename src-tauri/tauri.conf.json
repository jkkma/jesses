{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jesses",
  "version": "0.1.1",
  "identifier": "io.github.jkkma.jesses",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "jesses",
        "width": 1280,
        "height": 850,
        "minWidth": 760,
        "minHeight": 600,
        "theme": "Light",
        "backgroundColor": "#F0EEE6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "shortDescription": "Desktop media encoding, muxing, and analysis",
    "copyright": "Created by jkkma",
    "publisher": "jkkma",
    "homepage": "https://github.com/jkkma/jesses",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "resources/runtime-contract.json": "resources/runtime-contract.json",
      "../LICENSE": "resources/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "resources/THIRD_PARTY_NOTICES.md",
      "../licenses/shadcn-svelte-MIT.txt": "resources/licenses/shadcn-svelte-MIT.txt"
    },
    "linux": {
      "deb": { "recommends": ["ffmpeg"] }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
